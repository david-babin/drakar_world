{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "drakar.tech · server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/backend.js",
      "cwd": "${workspaceFolder}",
      "env": { "PORT": "8787" },
      "runtimeArgs": ["--no-warnings", "--env-file-if-exists=.env", "--enable-source-maps"],
      "preLaunchTask": "drakar: build",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": { "pattern": "http://localhost:([0-9]+)", "uriFormat": "http://localhost:%s", "action": "openExternally" }
    },
    {
      "name": "drakar.tech · server (fresh world)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/bin/backend.js",
      "cwd": "${workspaceFolder}",
      "env": { "PORT": "8787", "DB": "${workspaceFolder}/world-dev.db" },
      "runtimeArgs": ["--no-warnings", "--env-file-if-exists=.env"],
      "preLaunchTask": "drakar: build + delete world-dev.db",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "drakar.tech · simulation test",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/test/sim.test.mjs",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
